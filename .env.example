# ==============================================================================
# CLUB BACACHÁ (bacacha.com) — Production Environment Variables
# ==============================================================================

# Site URL (Canonical domain)
NEXT_PUBLIC_SITE_URL=https://bacacha.com

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Your project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Publishable / Anon key (safe for browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (CRITICAL: Server-side only, NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Messaging & Notifications (Optional / Phase 3 integrations)
# ------------------------------------------------------------------------------
# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Resend Email Service
RESEND_API_KEY=
EMAIL_FROM=Club Bacachá <hola@bacacha.com>
